# Supabase — set both to enable the database, storage, and every Admin
# CMS module. Without these, the site falls back to local file storage,
# which only works for local development (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin login credentials (mock auth — see lib/admin/auth.ts and the
# README's Auth section for what this is and isn't before going live).
NEXT_PUBLIC_ADMIN_EMAIL=admin@nexora.ai
NEXT_PUBLIC_ADMIN_PASSWORD=nexora-admin
